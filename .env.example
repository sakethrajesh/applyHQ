# Copy to .env and fill in (never commit .env)

# Overleaf session: paste token VALUE only (recommended), or full Cookie header
RESUME_OVERLEAF_COOKIES=YOUR_SESSION_TOKEN_HERE

# Optional: default Overleaf project id
# RESUME_OVERLEAF_PROJECT_ID=

# Web UI port on host (default 8080)
# WEB_PORT=8080
