# Optional template — copy to .env only if you want Compose to load these for interpolation.
# Not required: paste Overleaf cookies in the web UI after `docker compose up`.

# Optional: pre-seed API auth (otherwise use the UI)
# RESUME_OVERLEAF_COOKIES=YOUR_SESSION_TOKEN_HERE

# Optional: default Overleaf project id
# RESUME_OVERLEAF_PROJECT_ID=

# Optional: host port for local Docker (default 8080). Do NOT use 3000 on Coolify hosts.
# WEB_PORT=8080

# Coolify: leave WEB_PORT unset and use docker-compose.coolify.yml; set app port to 8080 in the UI.
